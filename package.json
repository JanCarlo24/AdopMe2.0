{
  "name": "adopme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AdopMe: adopción de mascotas en el navegador. Firebase opcional; sin red usa localStorage.",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test tests/unit/*.test.js && playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/firestore.rules.test.js\"",
    "seed:plan": "node scripts/seed-firestore.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonioA2006/AdopMe2.0.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.55.0",
    "firebase": "^11.6.0",
    "firebase-tools": "^13.35.1"
  }
}
